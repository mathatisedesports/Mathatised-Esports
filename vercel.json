{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mecs-apac", "destination": "/mecs-regionals", "permanent": true },
    { "source": "/mecs-apac.html", "destination": "/mecs-regionals", "permanent": true },
    { "source": "/assets/docs/mecs-rules-and-regulations.pdf", "destination": "/assets/docs/mathatised-esports-rules-and-regulations.pdf", "permanent": true }
  ],
  "functions": {
    "api/chat.js": { "includeFiles": "api/knowledge/**", "maxDuration": 30 },
    "api/discord.mjs": { "includeFiles": "api/knowledge/**", "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/docs/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
